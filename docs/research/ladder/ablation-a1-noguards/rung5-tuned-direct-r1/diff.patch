diff --git a/render.py b/render.py
index f17a074..89c41ca 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,13 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    if mark_last and rows:
+        result = []
+        for i, r in enumerate(rows):
+            if i == len(rows) - 1:
+                # Last row: prepend TOTAL
+                row_str = "TOTAL," + ",".join(str(v) for v in r)
+            else:
+                row_str = ",".join(str(v) for v in r)
+            result.append(row_str)
+        return result
+    else:
+        return [",".join(str(v) for v in r) for r in rows]
diff --git a/totals.py b/totals.py
