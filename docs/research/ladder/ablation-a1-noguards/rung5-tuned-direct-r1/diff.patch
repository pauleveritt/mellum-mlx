--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,18 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    num_cols = len(rows[0])
+    for i in range(num_cols):
+        total = 0
+        numeric_found = False
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                total += val
+                numeric_found = True
+        if numeric_found:
+            result.append(total)
+        else:
+            result.append("")
+    return result
