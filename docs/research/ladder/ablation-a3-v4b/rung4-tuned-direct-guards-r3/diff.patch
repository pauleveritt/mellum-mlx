diff --git a/export.py b/export.py
index 5904d9e..467af8d 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    lines = render_rows(rows)
+    if totals:
+        totals_row_values = column_totals(rows)
+        totals_row = ["TOTAL"] + [str(v) for v in totals_row_values]
+        lines.append(",".join(totals_row))
+    return "\n".join(lines)
diff --git a/render.py b/render.py
index f17a074..efd75e3 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last:
+        # Mark the last row by prepending "TOTAL," 
+        last = rendered[-1]
+        rendered[-1] = "TOTAL," + last
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..706d294 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,16 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            if isinstance(r[i], (int, float)):
+                total += r[i]
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
