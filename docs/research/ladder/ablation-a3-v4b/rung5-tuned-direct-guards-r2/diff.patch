diff --git a/export.py b/export.py
index 5904d9e..7d09b58 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    lines = render_rows(rows)
+    if totals:
+        totals_row = column_totals(rows)
+        totals_line = "TOTAL," + ",".join(str(v) for v in totals_row)
+        lines.append(totals_line)
+    return "\n".join(lines)
diff --git a/render.py b/render.py
index f17a074..349c748 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rendered:
+        last = rendered.pop()
+        rendered.append("TOTAL," + last)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..25e2cec 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,18 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    num_cols = len(rows[0])
+    totals = []
+    for i in range(num_cols):
+        col_values = [row[i] for row in rows]
+        total = 0
+        has_numeric = False
+        for v in col_values:
+            if isinstance(v, (int, float)):
+                total += v
+                has_numeric = True
+        if has_numeric:
+            totals.append(total)
+        else:
+            totals.append("")
+    return totals
