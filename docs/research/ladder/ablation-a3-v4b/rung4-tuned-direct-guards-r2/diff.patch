diff --git a/export.py b/export.py
index 5904d9e..a6b04ea 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,21 @@
 from render import render_rows
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+from totals import column_totals
+
+def export_csv(rows, totals=False):
+    rendered_rows = render_rows(rows)
+    if totals and rows:
+        total_row_values = column_totals(rows)
+        # Format total row values
+        # Process each value in total_row_values: empty strings or None stay empty, others converted to string
+        processed_values = []
+        for val in total_row_values:
+            if val == "" or val is None:
+                processed_values.append("")
+            else:
+                processed_values.append(str(val))
+        total_row = ["TOTAL"] + processed_values
+        total_row_str = ",".join(total_row)
+        rendered_rows.append(total_row_str)
+    return "\n".join(rendered_rows)
diff --git a/render.py b/render.py
index f17a074..8f14af2 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        total_row = ["TOTAL"] + [str(v) for v in last_row]
+        rendered[-1] = ",".join(total_row)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..324217e 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        column = [r[i] for r in rows]
+        # Check if all values are numbers (int or float)
+        if all(isinstance(v, (int, float)) for v in column):
+            result.append(sum(column))
+        else:
+            result.append("")
+    return result
