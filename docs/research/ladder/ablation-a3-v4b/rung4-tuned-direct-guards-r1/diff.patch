diff --git a/export.py b/export.py
index 5904d9e..11d1306 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,14 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals:
+        # Compute total row
+        totals_row_values = column_totals(rows)
+        totals_row = ["TOTAL"] + totals_row_values
+        totals_row_str = ",".join(str(v) for v in totals_row)
+        rendered_rows = render_rows(rows)
+        return "\n".join(rendered_rows) + "\n" + totals_row_str
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..e520446 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        last_rendered = ",".join(str(v) for v in last_row)
+        rendered[-1] = "TOTAL," + last_rendered
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..31c0e55 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,16 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    num_cols = len(rows[0])
+    totals = []
+    for i in range(num_cols):
+        col_values = []
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                col_values.append(val)
+        if col_values:
+            totals.append(sum(col_values))
+        else:
+            totals.append("")
+    return totals
