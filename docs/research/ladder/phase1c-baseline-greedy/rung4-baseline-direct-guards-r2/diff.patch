diff --git a/export.py b/export.py
index 5904d9e..897ea56 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,10 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals:
+        total_row = ["TOTAL"] + column_totals(rows)
+        return "\n".join(render_rows(rows + [total_row]))
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..6d906fa 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,8 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = []
+    for i, r in enumerate(rows):
+        line = ",".join(str(v) for v in r)
+        if mark_last and i == len(rows) - 1:
+            line = "TOTAL," + line
+        rendered.append(line)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..564f77f 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,18 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    num_cols = len(rows[0])
+    totals = []
+    for i in range(num_cols):
+        col_values = [row[i] for row in rows]
+        total = 0
+        has_numeric = False
+        for val in col_values:
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+        if has_numeric:
+            totals.append(total)
+        else:
+            totals.append("")
+    return totals
