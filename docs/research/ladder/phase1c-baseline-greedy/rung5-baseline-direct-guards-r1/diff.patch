diff --git a/export.py b/export.py
index 5904d9e..8fec779 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    rows_rendered = render_rows(rows)
+    if totals:
+        total_values = column_totals(rows)
+        total_row = ["TOTAL"] + total_values
+        rows_rendered.append(render_rows([total_row])[0])
+    return "\n".join(rows_rendered)
diff --git a/render.py b/render.py
index f17a074..d3d2514 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        modified_last = ["TOTAL"] + last_row
+        rendered[-1] = ",".join(str(v) for v in modified_last)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..ba84abd 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,19 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    num_cols = len(rows[0])
+    for i in range(num_cols):
+        total = 0
+        numeric_found = False
+        for row in rows:
+            if i < len(row):
+                val = row[i]
+                if isinstance(val, (int, float)):
+                    total += val
+                    numeric_found = True
+        if numeric_found:
+            result.append(total)
+        else:
+            result.append("")
+    return result
