diff --git a/export.py b/export.py
index 5904d9e..c53893f 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    csv_rows = render_rows(rows)
+    if totals:
+        from totals import column_totals
+        totals_vals = column_totals(rows)
+        totals_row = ["TOTAL"] + [str(v) for v in totals_vals]
+        csv_rows.append(",".join(totals_row))
+    return "\n".join(csv_rows)
diff --git a/render.py b/render.py
index f17a074..66d4bc6 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last = rows[-1]
+        rendered[-1] = "TOTAL," + ",".join(str(v) for v in last)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..eddbe50 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        col = [r[i] for r in rows]
+        # Check if all values in column are numbers
+        if all(isinstance(x, (int, float)) for x in col):
+            result.append(sum(col))
+        else:
+            result.append("")
+    return result
