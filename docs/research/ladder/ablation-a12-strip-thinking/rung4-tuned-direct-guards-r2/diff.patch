diff --git a/export.py b/export.py
index 5904d9e..94917e8 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals and rows:
+        total_row = column_totals(rows)
+        rows.append(total_row)
+        return "\n".join(render_rows(rows, mark_last=True))
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..34819ec 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row_str = ",".join(str(v) for v in rows[-1])
+        rendered[-1] = "TOTAL," + last_row_str
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..096f2b1 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,17 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for row in rows:
+            cell = row[i]
+            if isinstance(cell, (int, float)):
+                total += cell
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
