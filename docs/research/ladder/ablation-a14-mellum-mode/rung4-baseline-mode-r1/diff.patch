diff --git a/export.py b/export.py
index 5904d9e..d98a69c 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,12 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    rows_rendered = render_rows(rows)
+    if totals:
+        totals_row_values = column_totals(rows)
+        # Format totals row: start with "TOTAL", then the totals
+        totals_row = ["TOTAL"] + [str(v) if v != "" else "" for v in totals_row_values]
+        rows_rendered.append(",".join(totals_row))
+    return "\n".join(rows_rendered)
diff --git a/render.py b/render.py
index f17a074..4660ff1 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last = rendered[-1]
+        rendered[-1] = "TOTAL," + last
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..604b70a 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,13 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    totals = []
+    num_cols = len(rows[0])
+    for i in range(num_cols):
+        column_values = [r[i] for r in rows]
+        # Check if all values in this column are numbers (int or float)
+        if all(isinstance(v, (int, float)) for v in column_values):
+            totals.append(sum(column_values))
+        else:
+            totals.append('')
+    return totals
