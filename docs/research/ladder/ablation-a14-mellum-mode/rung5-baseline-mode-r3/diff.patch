diff --git a/export.py b/export.py
index 5904d9e..c67efbd 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,12 @@
 from render import render_rows
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    lines = render_rows(rows)
+    if totals:
+        from totals import column_totals
+        total_row_values = column_totals(rows)
+        # Format total row: start with "TOTAL", then the total values
+        total_row = ["TOTAL"] + [str(v) for v in total_row_values]
+        lines.append(",".join(total_row))
+    return "\n".join(lines)
diff --git a/render.py b/render.py
index f17a074..581c4ca 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,9 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    result = []
+    for i, r in enumerate(rows):
+        if mark_last and i == len(rows) - 1:
+            row_str = "TOTAL," + ",".join(str(v) for v in r)
+        else:
+            row_str = ",".join(str(v) for v in r)
+        result.append(row_str)
+    return result
