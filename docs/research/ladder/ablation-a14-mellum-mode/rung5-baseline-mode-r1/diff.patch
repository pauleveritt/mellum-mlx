diff --git a/export.py b/export.py
index 5904d9e..39a7237 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,18 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    csv_rows = render_rows(rows)
+    if totals:
+        totals_vals = column_totals(rows)
+        # Convert to int if whole number to avoid .0
+        formatted_vals = []
+        for v in totals_vals:
+            if isinstance(v, float) and v.is_integer():
+                formatted_vals.append(str(int(v)))
+            else:
+                formatted_vals.append(str(v))
+        total_row = ["TOTAL"] + formatted_vals
+        csv_rows.append(",".join(total_row))
+    return "\n".join(csv_rows)
diff --git a/render.py b/render.py
index f17a074..10257da 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rendered:
+        last = rendered[-1]
+        rendered[-1] = "TOTAL," + last
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..aac1d11 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,19 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        col_values = [r[i] for r in rows]
+        numeric_values = []
+        for val in col_values:
+            try:
+                num = float(val)
+                numeric_values.append(num)
+            except (ValueError, TypeError):
+                continue
+        if numeric_values:
+            total = sum(numeric_values)
+            result.append(total)
+        else:
+            result.append("")
+    return result
