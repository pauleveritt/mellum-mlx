diff --git a/totals.py b/totals.py
index 54cd29d..82fb092 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,16 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        numeric_count = 0
+        for r in rows:
+            if isinstance(r[i], (int, float)):
+                total += r[i]
+                numeric_count += 1
+        if numeric_count > 0:
+            result.append(total)
+        else:
+            result.append("")
+    return result
