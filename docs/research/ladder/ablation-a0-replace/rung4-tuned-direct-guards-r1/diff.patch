diff --git a/export.py b/export.py
index 5904d9e..a8b416e 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    lines = render_rows(rows)
+    if totals:
+        totals_row_values = column_totals(rows)
+        totals_row = "TOTAL," + ",".join(str(v) for v in totals_row_values)
+        lines.append(totals_row)
+    return "\n".join(lines)
diff --git a/render.py b/render.py
index f17a074..88e15e6 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    result = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_index = len(result) - 1
+        result[last_index] = "TOTAL," + result[last_index]
+    return result
diff --git a/totals.py b/totals.py
index 54cd29d..a3376ed 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    num_cols = len(rows[0])
+    totals = []
+    for i in range(num_cols):
+        col_values = [r[i] for r in rows]
+        if all(isinstance(v, (int, float)) for v in col_values):
+            totals.append(sum(col_values))
+        else:
+            totals.append("")
+    return totals
