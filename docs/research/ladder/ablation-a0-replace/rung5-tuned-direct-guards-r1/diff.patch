diff --git a/render.py b/render.py
index f17a074..335355c 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, **kwargs):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if kwargs.get('mark_last'):
+        if rendered:
+            last = rendered[-1]
+            rendered[-1] = "TOTAL," + last
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..f575d35 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,13 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    num_cols = len(rows[0])
+    for i in range(num_cols):
+        col_values = [r[i] for r in rows]
+        # Check if all values are numeric
+        if all(isinstance(v, (int, float)) for v in col_values):
+            result.append(sum(col_values))
+        else:
+            result.append("")
+    return result
