diff --git a/export.py b/export.py
index 5904d9e..e06c7c6 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,18 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals:
+        # Compute totals for each column
+        cols = column_totals(rows)
+        # Create totals row with "TOTAL" label
+        totals_row = ["TOTAL"] + cols
+        # Render all original rows
+        data_rows = render_rows(rows)
+        # Render totals row
+        totals_row_rendered = render_rows([totals_row])
+        # Combine
+        return "\n".join(data_rows + totals_row_rendered)
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..684768b 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,8 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = []
+    for i, r in enumerate(rows):
+        if mark_last and i == len(rows) - 1:
+            rendered.append("TOTAL," + ",".join(str(v) for v in r))
+        else:
+            rendered.append(",".join(str(v) for v in r))
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..bc833ee 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,18 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    num_cols = len(rows[0])
+    for i in range(num_cols):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
