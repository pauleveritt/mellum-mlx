--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,11 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    totals = []
+    for i in range(len(rows[0])):
+        vals = [r[i] for r in rows]
+        if all(isinstance(v, (int, float)) for v in vals):
+            totals.append(sum(vals))
+        else:
+            totals.append("")
+    return totals
