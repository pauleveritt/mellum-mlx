diff --git a/render.py b/render.py
index f17a074..57c5cd9 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = []
+    for idx, r in enumerate(rows):
+        if mark_last and idx == len(rows) - 1:
+            r = ["TOTAL"] + r
+        rendered.append(",".join(str(v) for v in r))
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..1156788 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,17 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
