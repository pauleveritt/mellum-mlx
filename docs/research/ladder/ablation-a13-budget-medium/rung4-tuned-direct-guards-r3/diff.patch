diff --git a/export.py b/export.py
index 5904d9e..c11ce3c 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    csv_rows = render_rows(rows)
+    if totals and rows:
+        total_row = column_totals(rows)
+        total_rendered = render_rows([total_row], mark_last=True)
+        csv_rows += total_rendered
+    return "\n".join(csv_rows)
diff --git a/render.py b/render.py
index f17a074..e520446 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        last_rendered = ",".join(str(v) for v in last_row)
+        rendered[-1] = "TOTAL," + last_rendered
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..8ee7c50 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,13 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    num_cols = len(rows[0])
+    for i in range(num_cols):
+        col_values = [row[i] for row in rows]
+        if all(isinstance(v, (int, float)) for v in col_values):
+            total = sum(col_values)
+            result.append(total)
+        else:
+            result.append("")
+    return result
