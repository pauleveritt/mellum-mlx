--- a/export.py
+++ b/export.py
@@ -1,5 +1,10 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    rendered = render_rows(rows)
+    if totals:
+        total_row = ["TOTAL"] + column_totals(rows)
+        rendered.append(render_rows([total_row])[0])
+    return "\n".join(rendered)
diff --git a/render.py b/render.py
index f17a074..64e3b76 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,11 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    row_strings = []
+    for i, r in enumerate(rows):
+        s = ",".join(str(v) for v in r)
+        if mark_last and i == len(rows) - 1:
+            if s == "":
+                s = "TOTAL"
+            else:
+                s = "TOTAL," + s
+        row_strings.append(s)
+    return row_strings
diff --git a/totals.py b/totals.py
index 54cd29d..1156788 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,17 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
