diff --git a/export.py b/export.py
index 5904d9e..f69e6d3 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,10 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    result = render_rows(rows)
+    if totals:
+        total_row = ["TOTAL"] + column_totals(rows)
+        result.append(render_rows([total_row])[0])
+    return "\n".join(result)
diff --git a/render.py b/render.py
index f17a074..97d0d7e 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = []
+    for i, r in enumerate(rows):
+        if mark_last and i == len(rows) - 1:
+            r = ["TOTAL"] + r
+        rendered.append(",".join(str(v) for v in r))
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..02a5d5c 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    totals = []
+    for i in range(len(rows[0])):
+        column = [r[i] for r in rows]
+        # Check if all values in the column are numbers (int or float)
+        if all(isinstance(x, (int, float)) for x in column):
+            totals.append(sum(column))
+        else:
+            totals.append("")
+    return totals
