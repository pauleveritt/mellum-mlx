diff --git a/export.py b/export.py
index 5904d9e..86cf331 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    rendered = render_rows(rows)
+    if totals:
+        totals_row = column_totals(rows)
+        total_row = ["TOTAL"] + [str(t) if t != "" else "" for t in totals_row]
+        rendered.append(",".join(total_row))
+    return "\n".join(rendered)
diff --git a/render.py b/render.py
index f17a074..ce0ea59 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_vals = [str(v) for v in rows[-1]]
+        rendered[-1] = "TOTAL," + ",".join(last_vals)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..56036d3 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    num_cols = len(rows[0])
+    totals = []
+    for i in range(num_cols):
+        col_values = [row[i] for row in rows]
+        if all(isinstance(v, (int, float)) for v in col_values):
+            totals.append(sum(col_values))
+        else:
+            totals.append("")
+    return totals
