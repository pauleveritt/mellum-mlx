diff --git a/render.py b/render.py
index f17a074..00ca829 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row_values = rows[-1]
+        last_row_str = ",".join(str(v) for v in last_row_values)
+        rendered[-1] = "TOTAL," + last_row_str
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..27f0773 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,25 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        col_values = [r[i] for r in rows]
+        numeric_values = []
+        for v in col_values:
+            try:
+                # Convert to float if possible
+                num = float(v)
+                numeric_values.append(num)
+            except (ValueError, TypeError):
+                # If not numeric, skip
+                pass
+        if numeric_values:
+            total = sum(numeric_values)
+            # If total is integer, return as int
+            if total.is_integer():
+                result.append(int(total))
+            else:
+                result.append(total)
+        else:
+            result.append("")
+    return result
