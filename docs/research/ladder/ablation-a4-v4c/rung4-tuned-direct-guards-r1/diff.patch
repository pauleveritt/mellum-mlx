diff --git a/export.py b/export.py
index 5904d9e..82187d6 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals:
+        totals_row = ["TOTAL"] + column_totals(rows)
+        all_rows = rows + [totals_row]
+        return "\n".join(render_rows(all_rows))
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..4660ff1 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last = rendered[-1]
+        rendered[-1] = "TOTAL," + last
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..8bab36f 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,13 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    ncols = len(rows[0])
+    totals = []
+    for i in range(ncols):
+        col_values = [r[i] for r in rows]
+        numeric_values = [v for v in col_values if isinstance(v, (int, float))]
+        if numeric_values:
+            totals.append(sum(numeric_values))
+        else:
+            totals.append("")
+    return totals
