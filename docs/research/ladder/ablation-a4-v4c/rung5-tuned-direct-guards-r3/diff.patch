diff --git a/export.py b/export.py
index 5904d9e..a3cb23a 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    rendered = render_rows(rows)
+    if totals:
+        totals_vals = column_totals(rows)
+        totals_row_vals = ["TOTAL"] + totals_vals
+        rendered.append(render_rows([totals_row_vals])[0])
+    return "\n".join(rendered)
diff --git a/render.py b/render.py
index f17a074..9a10e56 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,8 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rendered:
+        # Mark the last row by prepending "TOTAL" to it?
+        last_row_parts = rendered[-1].split(",")
+        last_row_parts.insert(0, "TOTAL")
+        rendered[-1] = ",".join(last_row_parts)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..7471a61 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        column = [r[i] for r in rows]
+        # Check if all values in the column are numbers (int or float)
+        if all(isinstance(x, (int, float)) for x in column):
+            result.append(sum(column))
+        else:
+            result.append("")
+    return result
