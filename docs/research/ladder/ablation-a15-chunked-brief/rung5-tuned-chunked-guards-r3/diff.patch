diff --git a/export.py b/export.py
index 5904d9e..c51fd92 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,12 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    rendered_rows = render_rows(rows)
+    if totals:
+        total_values = column_totals(rows)
+        total_row = ["TOTAL"] + [str(v) for v in total_values]
+        rendered_totals = render_rows([total_row])[0]
+        rendered_rows.append(rendered_totals)
+    return "\n".join(rendered_rows)
diff --git a/render.py b/render.py
index f17a074..9cf106a 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rendered:
+        last = rendered[-1].split(",")
+        rendered[-1] = "TOTAL," + ",".join(last)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..706d294 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,16 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            if isinstance(r[i], (int, float)):
+                total += r[i]
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
