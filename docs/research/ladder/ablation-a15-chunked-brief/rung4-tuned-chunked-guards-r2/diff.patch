diff --git a/export.py b/export.py
index 5904d9e..84762d3 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    base = "\n".join(render_rows(rows))
+    if totals:
+        tot = column_totals(rows)
+        totals_line = "TOTAL," + ",".join(str(v) for v in tot)
+        base = base + "\n" + totals_line
+    return base
diff --git a/render.py b/render.py
index f17a074..c1aa26b 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,5 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rendered:
+        rendered[-1] = "TOTAL," + rendered[-1]
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..b275709 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        column = [r[i] for r in rows]
+        # Check if all values in column are numbers (int or float)
+        if all(isinstance(val, (int, float)) for val in column):
+            result.append(sum(column))
+        else:
+            result.append("")
+    return result
