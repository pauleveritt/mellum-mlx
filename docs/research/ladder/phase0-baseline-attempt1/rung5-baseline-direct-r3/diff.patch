+def export_csv(rows, totals=False):
+    lines = render_rows(rows)
+    if totals and rows:
+        # Calculate totals for each column
+        num_cols = len(rows[0])
+        totals_row = [
+            sum(row[col] for row in rows if col < len(row))
+            for col in range(num_cols)
+        ]
+        lines.append(",".join(map(str, totals_row)))
+    return "\n".join(lines)
