diff --git a/export.py b/export.py
index 5904d9e..390c765 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    lines = render_rows(rows)
+    if totals:
+        # Compute column totals
+        totals_row = ["TOTAL"] + [str(t) for t in column_totals(rows)]
+        lines.append(",".join(totals_row))
+    return "\n".join(lines)
diff --git a/render.py b/render.py
index f17a074..3edad49 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rows_rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        last_rendered = ",".join(str(v) for v in last_row)
+        rows_rendered[-1] = "TOTAL," + last_rendered
+    return rows_rendered
diff --git a/totals.py b/totals.py
index 54cd29d..f043830 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,18 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            if i < len(r):
+                val = r[i]
+                if isinstance(val, (int, float)):
+                    total += val
+                    has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
