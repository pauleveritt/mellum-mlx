+def export_csv(rows, totals=False):
+    if totals:
+        # Compute total row
+        totals_row_vals = column_totals(rows)
+        # Format total row: start with "TOTAL," then each total value
+        total_row = ["TOTAL"] + [str(v) if v != "" else "" for v in totals_row_vals]
+        total_line = ",".join(total_row)
+        # Render the actual rows
+        lines = render_rows(rows)
+        # Append total line
+        lines.append(total_line)
+        return "\n".join(lines)
+    else:
+        return "\n".join(render_rows(rows))
