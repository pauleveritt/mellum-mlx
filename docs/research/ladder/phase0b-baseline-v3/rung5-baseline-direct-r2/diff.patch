diff --git a/totals.py b/totals.py
index 54cd29d..d586a0a 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,16 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        col = [r[i] for r in rows]
+        numeric_col = [x for x in col if isinstance(x, (int, float))]
+        if numeric_col:
+            total = sum(numeric_col)
+            if total.is_integer():
+                result.append(int(total))
+            else:
+                result.append(total)
+        else:
+            result.append("")
+    return result
