--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,16 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    totals = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            if isinstance(r[i], (int, float)):
+                total += r[i]
+                has_numeric = True
+        if has_numeric:
+            totals.append(total)
+        else:
+            totals.append("")
+    return totals
