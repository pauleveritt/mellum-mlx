 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    num_cols = len(rows[0])
+    totals = []
+    for i in range(num_cols):
+        col_values = [row[i] for row in rows]
+        total = 0
+        has_numeric = False
+        for val in col_values:
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+            elif isinstance(val, str):
+                try:
+                    num = float(val)
+                    total += num
+                    has_numeric = True
+                except ValueError:
+                    pass
+        if has_numeric:
+            totals.append(total)
+        else:
+            totals.append("")
+    return totals
