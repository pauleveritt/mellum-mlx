 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        column = [r[i] for r in rows]
+        # Check if all values in this column are numbers
+        if all(isinstance(v, (int, float)) for v in column):
+            result.append(sum(column))
+        else:
