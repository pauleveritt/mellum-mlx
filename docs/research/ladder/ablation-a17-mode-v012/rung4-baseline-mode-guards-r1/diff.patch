--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,18 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    num_columns = len(rows[0])
+    for i in range(num_columns):
+        total = 0
+        has_numeric = False
+        for row in rows:
+            val = row[i]
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+        if has_numeric:
+            result.append(total)
+        else:
+            result.append("")
+    return result
