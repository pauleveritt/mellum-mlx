diff --git a/export.py b/export.py
index 5904d9e..107b265 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,11 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    csv_rows = render_rows(rows)
+    if totals:
+        total_vals = column_totals(rows)
+        total_row = ["TOTAL"] + [str(v) for v in total_vals]
+        csv_rows.append(",".join(total_row))
+    return "\n".join(csv_rows)
diff --git a/render.py b/render.py
index f17a074..1d82d64 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,10 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    result = []
+    for i, r in enumerate(rows):
+        if mark_last and i == len(rows) - 1:
+            # Prepend 'TOTAL' to the row
+            vals = ["TOTAL"] + [str(v) for v in r]
+            result.append(",".join(vals))
+        else:
+            result.append(",".join(str(v) for v in r))
+    return result
diff --git a/totals.py b/totals.py
index 54cd29d..c9e96df 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,14 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                total += val
+                has_numeric = True
+        result.append(total if has_numeric else "")
+    return result
