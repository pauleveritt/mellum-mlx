diff --git a/render.py b/render.py
index f17a074..67193ff 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,8 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        # Create a new row with "TOTAL" followed by the last row's values
+        new_last = ["TOTAL"] + last_row
+        rendered[-1] = ",".join(str(v) for v in new_last)
+    return rendered
