 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        col_values = [row[i] for row in rows]
+        # Check if all values are numeric (int or float)
+        if all(isinstance(val, (int, float)) for val in col_values):
+            result.append(sum(col_values))
