diff --git a/export.py b/export.py
index 5904d9e..c332a11 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,18 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals:
+        # Compute total values for each column
+        total_values = column_totals(rows)
+        # Create a totals row: start with "TOTAL", then the total values
+        totals_row = ["TOTAL"] + total_values
+        # Render all original rows
+        rendered_rows = render_rows(rows)
+        # Render the totals row
+        rendered_totals = render_rows([totals_row])
+        # Combine
+        return "\n".join(rendered_rows + rendered_totals)
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..10257da 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rendered:
+        last = rendered[-1]
+        rendered[-1] = "TOTAL," + last
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..0b1357b 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,19 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_non_numeric = False
+        for r in rows:
+            val = r[i]
+            if isinstance(val, (int, float)):
+                total += val
+            else:
+                has_non_numeric = True
+                break
+        if has_non_numeric:
+            result.append("")
+        else:
+            result.append(total)
+    return result
