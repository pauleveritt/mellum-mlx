diff --git a/render.py b/render.py
index f17a074..d7d31d3 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,6 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        rendered[-1] = "TOTAL," + ",".join(str(v) for v in last_row)
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..521280d 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,24 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        total = 0
+        has_numeric = False
+        for r in rows:
+            try:
+                # Try to convert to float to handle numeric strings
+                val = float(r[i])
+                total += val
+                has_numeric = True
+            except (ValueError, TypeError):
+                # Ignore non-numeric values
+                pass
+        if has_numeric:
+            # If the total is an integer, keep it as int for cleaner output
+            if total.is_integer():
+                total = int(total)
+            result.append(total)
+        else:
+            result.append("")
+    return result
