diff --git a/export.py b/export.py
index 5904d9e..626ceef 100644
--- a/export.py
+++ b/export.py
@@ -1,5 +1,12 @@
 from render import render_rows
+from totals import column_totals
 
 
-def export_csv(rows):
-    return "\n".join(render_rows(rows))
+def export_csv(rows, totals=False):
+    if totals:
+        rows_rendered = render_rows(rows)
+        totals_row = column_totals(rows)
+        totals_str = "TOTAL," + ",".join(str(t) for t in totals_row)
+        return "\n".join(rows_rendered + [totals_str])
+    else:
+        return "\n".join(render_rows(rows))
diff --git a/render.py b/render.py
index f17a074..e520446 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def render_rows(rows):
-    return [",".join(str(v) for v in r) for r in rows]
+def render_rows(rows, mark_last=False):
+    rendered = [",".join(str(v) for v in r) for r in rows]
+    if mark_last and rows:
+        last_row = rows[-1]
+        last_rendered = ",".join(str(v) for v in last_row)
+        rendered[-1] = "TOTAL," + last_rendered
+    return rendered
diff --git a/totals.py b/totals.py
index 54cd29d..816e926 100644
--- a/totals.py
+++ b/totals.py
@@ -1,4 +1,12 @@
 def column_totals(rows):
     if not rows:
         return []
-    return [sum(r[i] for r in rows) for i in range(len(rows[0]))]
+    result = []
+    for i in range(len(rows[0])):
+        column = [r[i] for r in rows]
+        numeric_values = [v for v in column if isinstance(v, (int, float))]
+        if numeric_values:
+            result.append(sum(numeric_values))
+        else:
+            result.append("")
+    return result
